<?xml version="1.0" encoding="utf-8"?>
<!-- A Schmidt net: primitive circle, one great circle (a plane), one pole (a line).
     108dp canvas, content inside the 72dp safe zone (18..90). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- primitive -->
    <path
        android:pathData="M54,22 A32,32 0 1,1 53.99,22 Z"
        android:strokeColor="#e6e3dc"
        android:strokeWidth="3"
        android:fillColor="#00000000" />
    <!-- N tick -->
    <path
        android:pathData="M54,18 L54,28"
        android:strokeColor="#e6e3dc"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- a plane: great circle dipping east -->
    <path
        android:pathData="M54,22 Q82,54 54,86"
        android:strokeColor="#f0a040"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <!-- its pole -->
    <path
        android:pathData="M38,54 A5,5 0 1,1 37.99,54 Z"
        android:fillColor="#5aa2ff" />
</vector>
