<?xml version="1.0" encoding="utf-8"?>
<!--
  wuffle's manifest: label, icon, theme, activity. No permissions — the compass
  reads deviceorientation, which the WebView exposes without one; everything
  else is core (posture merges in from core's manifest).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="wuffle"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".WuffleActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- intake: a shared / opened CSV (a published wuffle log) reloads into the log -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
