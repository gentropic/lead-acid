<?xml version="1.0" encoding="utf-8"?>
<!-- micro's manifest: label, icon, theme, activity, and the intake filters — the
     data formats micro reads, so "Open with micro" shows up in Files and the share
     sheet. Permissions: none (posture merges in from core; no plugin here needs one). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="micro"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MicroActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- intake: block models, point clouds, meshes, grids, drillhole tables -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/vnd.apache.parquet" />
                <data android:mimeType="application/x-parquet" />
                <data android:mimeType="image/tiff" />
                <data android:mimeType="model/obj" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
            </intent-filter>
        </activity>
    </application>
</manifest>
