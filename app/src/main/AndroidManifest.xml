<?xml version="1.0" encoding="utf-8"?>
<!--
  The dev harness's manifest declares only what is ITS: label, theme, the
  activity. Posture (no backup, predictive back) comes from core's manifest;
  the share FileProvider from plugin-share's. Still no permissions (SPEC §8).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="lead-acid dev"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".DevActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
