# Ad-hoc experiments and scratch
experiments/

# Built artifacts dropped in for packaging — the monorepo builds these
# (micro.html, wuffle.html, …); they are inputs, not sources of this repo. Only
# artifact.html (the bench) is source. wuffle graduated to the monorepo
# (tools/wuffle → wuffle.html); build it there and copy the output into assets.
app/src/main/assets/*.html
!app/src/main/assets/artifact.html
# Instruments sync their artifact from the monorepo at build time (gradle.properties
# leadacid.artifactsDir) — never commit the copy.
wuffle/src/main/assets/
gnsslog/src/main/assets/
micro/src/main/assets/
lamina/src/main/assets/
ep/src/main/assets/

# npm pack output
*.tgz
